{
  "identity": {
    "id": "com.luxera.tictactoe",
    "name": "井字棋",
    "version": "1.0.0",
    "description": "三乘三的经典对局。真人和数字人各坐一边, 共用同一盘棋。",
    "category": "game"
  },

  "capabilities": [
    {
      "id": "game.play",
      "title": "对局",
      "description": "可以和真人或数字人下一盘棋",
      "category": "game"
    }
  ],

  "actions": [
    {
      "id": "game.create",
      "capability": "game.play",
      "title": "开一局",
      "description": "为当前会话开一盘新棋; 已经开过则返回当前局面",
      "permission": "WRITE",
      "risk": "LOW",
      "attention": "AWARE",
      "inputSchema": {
        "type": "object",
        "properties": {
          "opponentPrincipalId": {
            "type": "string",
            "description": "预先指定对手的 principal id; 留空表示等对手自己落座"
          }
        }
      },
      "agentHint": "开局永远是 X 先走。你是执 O 的一方时, 开完局什么都不用做, 等对手落子。"
    },
    {
      "id": "game.state",
      "capability": "game.play",
      "title": "看棋局",
      "description": "读取当前棋盘与轮次",
      "permission": "READ",
      "risk": "NONE",
      "attention": "NONE",
      "agentHint": "只读。看局面用它, 不要为了看局面而走一步棋。"
    },
    {
      "id": "game.make_move",
      "capability": "game.play",
      "title": "落子",
      "description": "在 0..8 的某个格子上放自己的记号",
      "permission": "EXECUTE",
      "risk": "LOW",
      "attention": "FOCUSED",
      "inputSchema": {
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8,
            "description": "格子序号, 从左到右、从上到下: 0 1 2 / 3 4 5 / 6 7 8"
          }
        },
        "required": ["position"]
      },
      "agentHint": "格子序号 0..8 按行排: 0 1 2 / 3 4 5 / 6 7 8。按这个顺序找落点, 找到第一个成立的就下那里: (1) 能立刻三连的位置 —— 直接赢; (2) 对手下一手能三连的位置 —— 必须堵; (3) 中心 4; (4) 自己顺手的一个角(0、2、6、8); (5) 任意空位。只能下在空格上, 只能在自己回合下。像真人一样下棋: 会赢就赢, 但别解释你的算法, 也别报格子序号, 说'我下中间'这种自然的话。"
    },
    {
      "id": "game.surrender",
      "capability": "game.play",
      "title": "认输",
      "description": "放弃这一局, 对手获胜",
      "permission": "EXECUTE",
      "risk": "LOW",
      "attention": "AWARE",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "agentHint": "只在明确表示不想再下、或局面已经没救了的时候用。认输是一局结束, 不是暂停。"
    }
  ],

  "resources": [
    {
      "type": "tictactoe.game",
      "uriTemplate": "game://session/{sessionId}",
      "backing": "RESOURCE_STORE",
      "agentHint": "state.board 是长度 9 的数组, 每项是 \"X\" / \"O\" / null; state.seats 是两个座位的 principal id(可能为 null); state.turn 是当前该谁走(\"X\" 或 \"O\"); state.winner 是 \"X\" / \"O\" / \"DRAW\" / null。你的记号由你的座位决定: seats[0] 执 X, seats[1] 执 O —— 与你是人还是数字人无关。"
    }
  ],

  "events": [
    {
      "type": "game.start",
      "title": "开局",
      "triggersAgent": false
    },
    {
      "type": "game.move",
      "title": "有人落子",
      "triggersAgent": true,
      "idTemplate": "{uri}#MOVE-{moves}"
    },
    {
      "type": "game.finish",
      "title": "分出胜负",
      "triggersAgent": true,
      "idTemplate": "{uri}#FINISH-{winner}"
    }
  ],

  "permissions": [
    {
      "capability": "game.play",
      "level": "EXECUTE",
      "riskCeiling": "LOW"
    }
  ],

  "runtime": {
    "type": "NATIVE"
  },

  "ui": {
    "type": "EMBEDDED",
    "entry": "/applications/{applicationId}",
    "minClientVersion": "1.0.0",
    "surfaces": [
      { "type": "FULL_PAGE", "entry": "/applications/{applicationId}/sessions/{sessionId}" },
      { "type": "EMBEDDED",  "entry": "/applications/{applicationId}/sessions/{sessionId}?surface=EMBEDDED" },
      { "type": "MODAL",     "entry": "/applications/{applicationId}/sessions/{sessionId}?surface=MODAL" },
      { "type": "PANEL",     "entry": "/applications/{applicationId}/sessions/{sessionId}?surface=PANEL" },
      { "type": "INLINE",    "entry": "/applications/{applicationId}/sessions/{sessionId}?surface=INLINE" }
    ]
  }
}
